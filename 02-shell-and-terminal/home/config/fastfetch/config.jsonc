{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none",
    "color": {
      "1": "#ffe063",
      "2": "#f3e563"
    }
  },
  "display": {
    "separator": " ",
    "key": {
      "width": 15
    },
    "color": {
      "keys": "#ffe09b",
      "title": "#f3e5ca"
    },
    "percent": {
      "color": {
        "green": "#8ba9e4",
        "yellow": "#ffd780",
        "red": "#ff5c78"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "key": "╭──────────────────────────────────────╮"
    },
    {
      "type": "kernel",
      "key": "│  kernel",
      "format": "{release>24} │"
    },
    {
      "type": "command",
      "key": "│  uptime",
      "text": "uptime -p | cut -d ' ' -f 2-",
      "format": "{>24} │"
    },
    {
      "type": "shell",
      "key": "│  shell",
      "format": "{pretty-name>24} │"
    },
    {
      "type": "command",
      "key": "│  mem",
      "text": "free -m | awk 'NR==2{printf \"%.2f GiB / %.2f GiB\",$3/1024,$2/1024}'",
      "format": "{>24} │"
    },
    {
      "type": "packages",
      "key": "│  pkgs",
      "format": "{all>24} │"
    },
    {
      "type": "command",
      "key": "│  user",
      "text": "echo $USER",
      "format": "{>24} │"
    },
    {
      "type": "command",
      "key": "│  hname",
      "text": "hostnamectl hostname",
      "format": "{>24} │"
    },
    {
      "type": "os",
      "key": "│ 󰻀 distro",
      "format": "{pretty-name>24} │"
    },
    {
      "type": "custom",
      "key": "╰──────────────────────────────────────╯"
    }
  ]
}
