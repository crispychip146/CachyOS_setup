alias ls='eza --icons'
alias ll='eza -lah --icons --git'
alias cat='bat'
alias v='nvim'

function f() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
    yazi "$@" --cwd-file="$tmp"

    if cwd="$(cat -- "$tmp")" && [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
        builtin cd -- "$cwd"
    fi

    rm -f -- "$tmp"
}

if [[ -o interactive ]]; then
    fastfetch
fi

