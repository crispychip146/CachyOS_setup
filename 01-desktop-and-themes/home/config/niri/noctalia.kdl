layout {

    focus-ring {
        active-color   "#ffe09b"
        inactive-color "#000000"
        urgent-color   "#ff5c78"
    }

    border {
        active-color   "#ffe09b"
        inactive-color "#000000"
        urgent-color   "#ff5c78"
    }


    tab-indicator {
        active-color   "#ffe09b"
        inactive-color "#544f41"
        urgent-color   "#ff5c78"
    }

    insert-hint {
        color "#ffe09b80"
    }
}

recent-windows {
    highlight {
        active-color "#ffe09b"
        urgent-color "#ff5c78"
    }
}
