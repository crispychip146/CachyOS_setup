# window border
window.active.border.color: #d87cff
window.inactive.border.color: #ffe5ae

# ToggleKeybinds status indicator
window.active.indicator.toggled-keybind.color: #ff5c78

# window titlebar background
window.active.title.bg.color: #d87cff
window.inactive.title.bg.color: #ffe5ae

window.active.label.text.color: #080a10
window.inactive.label.text.color: #080a10
window.label.text.justify: center

# window button hover overlay
window.button.hover.bg.color: #2a1340

# window buttons
window.active.button.unpressed.image.color: #080a10
window.inactive.button.unpressed.image.color: #080a10

# menu
menu.border.color: #080a10
menu.items.bg.color: #d87cff
menu.items.text.color: #080a10
menu.items.active.bg.color: #ffe5ae
menu.items.active.text.color: #080a10
menu.separator.color: #080a10
menu.title.bg.color: #d87cff
menu.title.text.color: #080a10

# on screen display (window-cycle dialog)
osd.bg.color: #d87cff
osd.border.color: #080a10
osd.label.text.color: #080a10
osd.window-switcher.preview.border.color: #8c5da4
